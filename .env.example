# TASARA — Environment Variables
# Copy this to a .env file and fill in your values
# OR configure in Vercel dashboard / Supabase project settings

# ============================================================
# SUPABASE
# ============================================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # for edge functions only

# ============================================================
# RESEND (Email)
# ============================================================
# Get from: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Admin email for notifications
ADMIN_EMAIL=admin@tasara.ng

# ============================================================
# TELEGRAM
# ============================================================
# The community invite link shown to all users
TELEGRAM_COMMUNITY_URL=https://t.me/tasara_community

# ============================================================
# DEPLOYMENT
# ============================================================
# Vercel will handle this automatically
# No additional config needed
